{
  "name": "shedlink-preact-pilot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/check-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:live": "vitest run test/skillgame-live.test.ts test/skillgame-complete-live.test.ts --no-file-parallelism"
  },
  "dependencies": {
    "preact": "11.0.0"
  },
  "devDependencies": {
    "@testing-library/preact": "3.2.4",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "jsdom": "30.1.1",
    "playwright": "1.58.2",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}

<Project Sdk="Microsoft.NET.Sdk">
  <!-- Регрессия по независимой проверке 12.09.2026 (dist/audit/autopilot-review).
       Компилирует НАСТОЯЩИЙ исходник мода против минимальных заменителей движка:
       копия исходника разошлась бы с оригиналом молча. Проверяет поток управления
       и владение состоянием, но не исход живого боя и не загрузку настоящего сейва. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <NoWarn>0649;0169</NoWarn>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/AutopilotBehavior.cs" Link="AutopilotBehavior.cs" />
    <Compile Include="../../src/EngineContract.cs" Link="EngineContract.cs" />
  </ItemGroup>
</Project>

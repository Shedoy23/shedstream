<Prefab>
  <!--
    Sprint 5.33 NAMETAG-1 (2026-05-28): Custom @username nametag над adopted
    heroes в Mission. Pattern из BLT-Lait (Lait96/Bannerlord-Twitch-lait) —
    избегает Harmony-патч engine MissionNameMarkerTargetVM (generic в
    Bannerlord 1.3.x, нестабильный target).

    HeroNametagMissionView.cs создаёт GauntletLayer + LoadMovie на этот
    prefab. ViewModel HeroNametagListVM содержит MBBindingList<HeroNametagVM>.
    Каждый HeroNametagVM: HeroName, IsVisible, PositionX/Y, Color, Width,
    Height, FontSize. MissionView пересчитывает positions on every tick
    через MBWindowManager.WorldToScreen.
  -->
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>
        <Widget DataSource="{Heroes}"
                WidthSizePolicy="StretchToParent"
                HeightSizePolicy="StretchToParent">
          <ItemTemplate>
            <Widget DataSource="{.}"
                    IsVisible="@IsVisible"
                    WidthSizePolicy="Fixed"
                    HeightSizePolicy="Fixed"
                    SuggestedWidth="@Width"
                    SuggestedHeight="@Height"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    ScaledPositionXOffset="@PositionX"
                    ScaledPositionYOffset="@PositionY">
              <Children>
                <ListPanel WidthSizePolicy="Fixed"
                           SuggestedWidth="@Width"
                           HeightSizePolicy="Fixed"
                           SuggestedHeight="@Height"
                           LayoutImp.LayoutMethod="HorizontalLeftToRight"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent"
                                HeightSizePolicy="StretchToParent"
                                VerticalAlignment="Center"
                                Brush="FiraSansExtraCondensed-Regular"
                                Brush.TextHorizontalAlignment="Center"
                                Brush.FontSize="@FontSize"
                                Text="@HeroName"
                                Brush.FontColor="@Color" />
                  </Children>
                </ListPanel>
              </Children>
            </Widget>
          </ItemTemplate>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- Контрпример независимой проверки 13.09: свойство, которое мод читает, без
       публичного чтения. Контракт обязан его ОТВЕРГАТЬ. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <NoWarn>0649;0169</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/EngineContract.cs" Link="EngineContract.cs" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- Harness гоняет НАСТОЯЩИЕ исходники мода, а не их копию: оба файла ниже
       подключены через Compile Include из BannerlordLink/src. Оба намеренно
       не зависят от TaleWorlds, поэтому проверка идёт без игровых DLL — и CI
       может её запускать (мод целиком CI не собирает). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>StateSyncHarness</AssemblyName>
    <RootNamespace>StateSyncHarness</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Util/StateSyncTracker.cs" Link="StateSyncTracker.cs" />
    <Compile Include="../../src/Net/EventAckParser.cs" Link="EventAckParser.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>

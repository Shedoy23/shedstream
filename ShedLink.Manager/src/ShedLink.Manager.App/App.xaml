<Application x:Class="ShedLink.Manager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#10131A" />
        <SolidColorBrush x:Key="CardBackground" Color="#1A1F2B" />
        <SolidColorBrush x:Key="Primary" Color="#7C5CFC" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F5F7FF" />
        <SolidColorBrush x:Key="TextMuted" Color="#A7B0C3" />
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource Primary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Application.Resources>
</Application>

<Window x:Class="ShedLink.Manager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShedLink Manager" Width="760" Height="680"
        MinWidth="680" MinHeight="580"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,28">
                <TextBlock Text="ShedLink Manager" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="Подключим RimWorld к стриму без ручных токенов и конфигов."
                           Foreground="{StaticResource TextMuted}" FontSize="15" Margin="0,8,0,0" />
            </StackPanel>

            <Border Grid.Row="1" Background="{StaticResource CardBackground}"
                    CornerRadius="14" Padding="22" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="1. Аккаунт Twitch" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="AccountStatusText" Text="Проверяем сохранённый вход…"
                                   Foreground="{StaticResource TextMuted}" Margin="0,7,0,0" />
                        <TextBlock x:Name="PairingCodeText" Foreground="#C9BBFF"
                                   FontSize="16" FontWeight="Bold" Margin="0,7,0,0" />
                    </StackPanel>
                    <Button x:Name="ConnectButton" Grid.Column="1" Content="Войти через Twitch"
                            Click="ConnectButton_Click" VerticalAlignment="Center" Margin="18,0,0,0" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="{StaticResource CardBackground}"
                    CornerRadius="14" Padding="22" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="2. RimWorld" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="GameStatusText" Text="Ищем игру…"
                                   Foreground="{StaticResource TextMuted}" Margin="0,7,0,0"
                                   TextWrapping="Wrap" MaxWidth="500" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Выбрать папку"
                            Click="ChooseGameButton_Click" VerticalAlignment="Center"
                            Margin="18,0,0,0" Background="#343B4C" />
                </Grid>
            </Border>

            <Border Grid.Row="3" Background="{StaticResource CardBackground}"
                    CornerRadius="14" Padding="22" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="3. Интеграция RimLink" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="IntegrationStatusText"
                                   Text="Проверяем доступность безопасного релиза…"
                                   Foreground="{StaticResource TextMuted}" Margin="0,7,0,0"
                                   TextWrapping="Wrap" MaxWidth="500" />
                    </StackPanel>
                    <Button x:Name="InstallButton" Grid.Column="1" Content="Установить"
                            IsEnabled="False" Click="InstallButton_Click"
                            VerticalAlignment="Center" Margin="18,0,0,0" />
                </Grid>
            </Border>

            <Border Grid.Row="4" Background="#151A24" CornerRadius="10" Padding="16">
                <TextBlock x:Name="OverallStatusText" Text="Подготавливаем Manager…"
                           Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </ScrollViewer>
</Window>

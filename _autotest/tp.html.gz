              <div class="flex items-center justify-between mb-5">
                <p class="text-xs">
                  
                    
                    <span data-i18n="legal-enlegalchannel-points-acceptable-use-policy20191209:modified" style="display: block;">
                        Last modified on 
                        
                          12/09/2019
                        
                    </span>
                    
                  
                  
                      <span data-i18n="legal-enlegalchannel-points-acceptable-use-policy20191209:modified" style="display: block;">
                          <a class="font-bold text-brand-purple" href="/en/legal/channel-points-acceptable-use-policy/archive">See prior versions of Channel Points Acceptable Use Policy</a>
                      </span>
                  
